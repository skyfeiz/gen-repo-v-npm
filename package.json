{
  "name": "gen-repo-v",
  "version": "0.1.2",
  "description": "从当前项目的 Git 信息生成 version.json，供 npx 或构建脚本使用",
  "type": "module",
  "bin": {
    "gen-repo-v": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "lib",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/cli.mjs",
    "release": "bumpp"
  },
  "keywords": [
    "repo",
    "version",
    "git",
    "build",
    "version.json"
  ],
  "author": "skyfeiz <webyicunhui@outlook.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/skyfeiz/gen-repo-v-npm"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "bumpp": "^11.1.0"
  }
}
